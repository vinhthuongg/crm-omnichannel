APP_NAME="CRM Omnichannel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_omnichannel
DB_USERNAME=crm_omnichannel
DB_PASSWORD=change_this_database_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=crm
REVERB_APP_KEY=crm-key
REVERB_APP_SECRET=change_this_reverb_secret

# Internal Reverb listener used by Laravel and Supervisor.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Public browser websocket endpoint proxied by Nginx.
REVERB_PUBLIC_HOST=crm.example.com
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=wss

FACEBOOK_VERIFY_TOKEN=change_this_verify_token
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_LOGIN_SCOPES=email,public_profile,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging
MESSENGER_APP_ID="${FACEBOOK_CLIENT_ID}"
MESSENGER_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"

ZALO_ACCESS_TOKEN=

TEXT_API_BASE_URL=https://api.livechatinc.com/v3.6
TEXT_BRIDGE_ENABLED=false
TEXT_CLIENT_ID=
TEXT_ORGANIZATION_ID=
TEXT_AGENT_EMAIL=
TEXT_API_TOKEN=
TEXT_AGENT_ACCESS_TOKEN=
TEXT_DEFAULT_GROUP_ID=
TEXT_HUMAN_GROUP_ID=
TEXT_WEBHOOK_SECRET=
