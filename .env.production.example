# Tên ứng dụng hiển thị trong giao diện, email và notification.
APP_NAME="CRM Omnichannel"
# Xác định đây là môi trường production để Laravel dùng cấu hình tối ưu vận hành.
APP_ENV=production
# Khóa mã hóa dữ liệu Laravel; tạo riêng trên máy chủ bằng `php artisan key:generate`.
APP_KEY=
# Tắt trang lỗi chi tiết để không làm lộ cấu hình và mã nguồn cho người dùng.
APP_DEBUG=false
# URL HTTPS chính thức dùng để tạo route và callback OAuth.
APP_URL=https://crm.example.com
# Múi giờ dùng khi xử lý ca trực, hội thoại và báo cáo.
APP_TIMEZONE=Asia/Bangkok

# Ngôn ngữ mặc định của validation và bản dịch ứng dụng.
APP_LOCALE=en
# Ngôn ngữ dùng thay thế khi thiếu bản dịch.
APP_FALLBACK_LOCALE=en
# Ghi log qua nhóm logger `stack` đã khai báo trong Laravel.
LOG_CHANNEL=stack
# Chỉ ghi warning trở lên để giảm log không cần thiết trên production.
LOG_LEVEL=warning

# Driver kết nối cơ sở dữ liệu production.
DB_CONNECTION=mysql
# Máy chủ MySQL chứa dữ liệu CRM.
DB_HOST=127.0.0.1
# Cổng dịch vụ MySQL.
DB_PORT=3306
# Database lưu tài khoản, khách hàng, hội thoại, tin nhắn và cấu hình CRM.
DB_DATABASE=crm_omnichannel
# Tài khoản MySQL dành riêng cho ứng dụng.
DB_USERNAME=crm_omnichannel
# Mật khẩu MySQL production; bắt buộc thay giá trị mẫu trước khi triển khai.
DB_PASSWORD=change_this_database_password

# Lưu phiên đăng nhập trong Redis để chia sẻ giữa các web worker.
SESSION_DRIVER=redis
# Thời gian tồn tại của phiên đăng nhập, tính bằng phút.
SESSION_LIFETIME=120
# Domain được phép nhận session cookie; để trống sẽ dùng domain hiện tại.
SESSION_DOMAIN=
# Chỉ gửi session cookie qua kết nối HTTPS.
SESSION_SECURE_COOKIE=true

# Lưu cache ứng dụng trong Redis.
CACHE_STORE=redis
# Xử lý job gửi tin và notification qua hàng đợi Redis.
QUEUE_CONNECTION=redis
# Thư viện PHP dùng để giao tiếp với Redis.
REDIS_CLIENT=predis
# Máy chủ Redis dùng chung cho session, cache và queue.
REDIS_HOST=127.0.0.1
# Mật khẩu Redis; `null` khi Redis không bật xác thực.
REDIS_PASSWORD=null
# Cổng kết nối Redis.
REDIS_PORT=6379
# Database Redis mặc định dành cho session và dữ liệu ứng dụng.
REDIS_DB=0
# Database Redis tách riêng cho cache.
REDIS_CACHE_DB=1
# Tên queue mặc định mà worker production theo dõi.
REDIS_QUEUE=default
# Số giây trước khi job chưa hoàn tất được đưa lại vào queue.
REDIS_QUEUE_RETRY_AFTER=120

# Dùng Laravel Reverb để phát sự kiện hội thoại và tin nhắn realtime.
BROADCAST_CONNECTION=reverb
# Định danh ứng dụng để Laravel xác thực với Reverb.
REVERB_APP_ID=crm
# Khóa công khai dùng cho kết nối Reverb.
REVERB_APP_KEY=crm-key
# Bí mật ký request Reverb; bắt buộc thay giá trị mẫu trước khi triển khai.
REVERB_APP_SECRET=change_this_reverb_secret

# Địa chỉ Reverb lắng nghe nội bộ cho Laravel, Supervisor hoặc reverse proxy.
REVERB_SERVER_HOST=127.0.0.1
# Cổng tiến trình Reverb lắng nghe nội bộ.
REVERB_SERVER_PORT=8080
# Host Laravel dùng khi phát sự kiện tới Reverb.
REVERB_HOST=127.0.0.1
# Cổng Laravel dùng khi phát sự kiện tới Reverb.
REVERB_PORT=8080
# Giao thức nội bộ giữa Laravel và Reverb.
REVERB_SCHEME=http

# Tên miền WebSocket công khai được Nginx chuyển tiếp tới Reverb.
REVERB_PUBLIC_HOST=crm.example.com
# Cổng WebSocket công khai; để trống để dùng cổng chuẩn của giao thức.
REVERB_PUBLIC_PORT=
# Dùng WebSocket bảo mật TLS cho kết nối từ trình duyệt.
REVERB_PUBLIC_SCHEME=wss

# Chuỗi bí mật Facebook dùng khi xác minh webhook của hệ thống.
FACEBOOK_VERIFY_TOKEN=change_this_verify_token
# Phiên bản Graph API dùng cho OAuth, Page và Messenger.
FACEBOOK_GRAPH_VERSION=v25.0
# App ID của ứng dụng Facebook production.
FACEBOOK_CLIENT_ID=
# App Secret dùng để đổi OAuth code và xác thực request Facebook.
FACEBOOK_CLIENT_SECRET=
# Bí mật xác minh chữ ký webhook; mặc định dùng Facebook Client Secret.
FACEBOOK_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"
# URL callback Facebook OAuth trên domain production.
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
# ID cấu hình Facebook Login for Business nếu ứng dụng sử dụng cấu hình riêng.
FACEBOOK_LOGIN_CONFIG_ID=
# Các quyền cần để đọc Page, quản lý webhook và gửi nhận Messenger.
FACEBOOK_LOGIN_SCOPES=email,public_profile,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging
# App ID Messenger; mặc định dùng chung Facebook Client ID.
MESSENGER_APP_ID="${FACEBOOK_CLIENT_ID}"
# App Secret Messenger; mặc định dùng chung Facebook Client Secret.
MESSENGER_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"

# Access token của Zalo Official Account dùng để gọi API gửi tin.
ZALO_ACCESS_TOKEN=

# URL gốc của Text/LiveChat API dùng để đồng bộ kênh chat ngoài.
TEXT_API_BASE_URL=https://api.livechatinc.com/v3.6
# Bật hoặc tắt cầu nối tích hợp Text/LiveChat.
TEXT_BRIDGE_ENABLED=false
# Client ID OAuth của ứng dụng Text/LiveChat.
TEXT_CLIENT_ID=
# Client Secret OAuth của ứng dụng Text/LiveChat.
TEXT_CLIENT_SECRET=
# URL callback nhận authorization code từ Text/LiveChat.
TEXT_REDIRECT_URI="${APP_URL}/auth/text/callback"
# ID tổ chức Text/LiveChat chứa agent và nhóm được đồng bộ.
TEXT_ORGANIZATION_ID=
# Email agent đại diện được dùng khi gọi Text/LiveChat API.
TEXT_AGENT_EMAIL=
# API token tĩnh của agent nếu tích hợp sử dụng cơ chế token trực tiếp.
TEXT_API_TOKEN=
# OAuth access token hiện tại của agent Text/LiveChat.
TEXT_AGENT_ACCESS_TOKEN=
# Refresh token dùng để cấp lại access token Text/LiveChat.
TEXT_AGENT_REFRESH_TOKEN=
# Thời điểm access token Text/LiveChat hết hạn.
TEXT_AGENT_TOKEN_EXPIRES_AT=
# ID ứng dụng Messenger tương ứng trong hệ thống Text/LiveChat.
TEXT_MESSENGER_APP_ID=
# ID nhóm mặc định nhận hội thoại mới từ cầu nối.
TEXT_DEFAULT_GROUP_ID=
# ID nhóm nhân viên tiếp nhận hội thoại sau khi bot chuyển giao.
TEXT_HUMAN_GROUP_ID=
# Bí mật dùng để xác minh chữ ký webhook Text/LiveChat.
TEXT_WEBHOOK_SECRET=
