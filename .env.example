APP_NAME="CRM Omnichannel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_omnichannel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
PERMISSION_CACHE_STORE=array

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=crm
REVERB_APP_KEY=crm-key
REVERB_APP_SECRET=crm-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=wss

FACEBOOK_VERIFY_TOKEN=crm_verify_token_123
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_LOGIN_SCOPES=email,public_profile,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging
FACEBOOK_APP_SECRET=
MESSENGER_APP_ID="${FACEBOOK_CLIENT_ID}"
MESSENGER_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"
ZALO_ACCESS_TOKEN=

BOTPRESS_ENABLED=false
BOTPRESS_API_KEY=
BOTPRESS_WEBHOOK_URL=
BOTPRESS_BASE_URL=https://chat.botpress.cloud
BOTPRESS_WEBHOOK_ID=
BOTPRESS_ENCRYPTION_KEY=
BOTPRESS_CALLBACK_SECRET=
BOTPRESS_PREFER_CALLBACK=true
BOTPRESS_RESPONSE_POLL_ATTEMPTS=18
BOTPRESS_RESPONSE_POLL_DELAY_MS=300
BOTPRESS_RESPONSE_POLL_STABLE_ATTEMPTS=1
BOTPRESS_SNAPSHOT_KNOWN_MESSAGES=false
BOTPRESS_SEND_OUTBOUND_SYNC=true
BOTPRESS_GENERATE_QUICK_REPLIES=true
BOTPRESS_IDLE_RESUME_MINUTES=2
BOTPRESS_ADMIN_TOKEN=
CHAT_WEBVIEW_TOKEN=
BOTPRESS_STUDIO_URL=
BOTPRESS_KNOWLEDGE_WEBHOOK_URL=
BOTPRESS_KNOWLEDGE_WEBHOOK_SECRET=
CUSTOMER_IDLE_FOLLOW_UP_MINUTES=3

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_TIMEOUT=12

GROQ_QUICK_REPLIES_ENABLED=false
GROQ_QUICK_REPLIES_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_QUICK_REPLY_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=1.2
GROQ_CONNECT_TIMEOUT=0.5

FIREBASE_FCM_ENABLED=false
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_TIMEOUT=10

VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_PROVIDER=local
VECTOR_SEARCH_DIMENSIONS=384
VECTOR_SEARCH_TOP_K=50
VECTOR_SEARCH_MIN_SCORE=0.08
VECTOR_SEARCH_CUSTOMER_MESSAGE_LIMIT=40
