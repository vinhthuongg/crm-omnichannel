# Tên ứng dụng hiển thị trong giao diện, email và thông báo hệ thống.
APP_NAME="CRM Omnichannel"
# Môi trường chạy cục bộ; Laravel dùng giá trị này để chọn hành vi phù hợp môi trường.
APP_ENV=local
# Khóa mã hóa cookie và dữ liệu nhạy cảm; tạo bằng `php artisan key:generate`.
APP_KEY=
# Hiển thị chi tiết lỗi khi phát triển; phải tắt trên production.
APP_DEBUG=true
# URL gốc dùng để tạo route, callback OAuth và liên kết công khai.
APP_URL=http://localhost
# Múi giờ mặc định khi Laravel đọc, ghi và hiển thị thời gian.
APP_TIMEZONE=Asia/Bangkok

# Ngôn ngữ mặc định của thông báo validation và bản dịch ứng dụng.
APP_LOCALE=en
# Ngôn ngữ dự phòng khi không tìm thấy bản dịch trong ngôn ngữ mặc định.
APP_FALLBACK_LOCALE=en
# Kênh ghi log; `stack` cho phép kết hợp nhiều logger trong cấu hình logging.
LOG_CHANNEL=stack
# Mức log thấp nhất được ghi khi phát triển.
LOG_LEVEL=debug

# Driver cơ sở dữ liệu Laravel sử dụng.
DB_CONNECTION=mysql
# Máy chủ MySQL của ứng dụng.
DB_HOST=127.0.0.1
# Cổng kết nối MySQL.
DB_PORT=3306
# Tên database lưu người dùng, khách hàng, hội thoại và tin nhắn CRM.
DB_DATABASE=crm_omnichannel
# Tài khoản dùng để kết nối MySQL.
DB_USERNAME=root
# Mật khẩu của tài khoản MySQL; để trống nếu môi trường local không đặt mật khẩu.
DB_PASSWORD=

# Lưu phiên đăng nhập trong Redis để dùng được giữa nhiều tiến trình web.
SESSION_DRIVER=redis
# Đưa job gửi tin, notification và tác vụ nền vào hàng đợi Redis.
QUEUE_CONNECTION=redis
# Thời gian giữ job đã reserve phải lớn hơn timeout stream chatbot để worker không nhận trùng job đang chạy.
REDIS_QUEUE_RETRY_AFTER=180
# Lưu cache ứng dụng trong Redis.
CACHE_STORE=redis
# Giữ cache quyền trong bộ nhớ của từng request ở môi trường phát triển.
PERMISSION_CACHE_STORE=array

# Thư viện PHP dùng để giao tiếp với Redis.
REDIS_CLIENT=predis
# Máy chủ Redis lưu session, cache và queue.
REDIS_HOST=127.0.0.1
# Mật khẩu Redis; `null` nghĩa là máy chủ không yêu cầu xác thực.
REDIS_PASSWORD=null
# Cổng kết nối Redis.
REDIS_PORT=6379

# Dùng Laravel Reverb để phát sự kiện hội thoại và tin nhắn theo thời gian thực.
BROADCAST_CONNECTION=reverb
# Định danh ứng dụng được Reverb dùng để xác thực kết nối nội bộ.
REVERB_APP_ID=crm
# Khóa công khai dùng khi client hoặc Laravel kết nối Reverb.
REVERB_APP_KEY=crm-key
# Bí mật ký request giữa Laravel và Reverb; cần thay bằng giá trị riêng ở môi trường thật.
REVERB_APP_SECRET=crm-secret
# Địa chỉ Reverb mà Laravel kết nối từ máy chủ.
REVERB_HOST=127.0.0.1
# Cổng Reverb mà Laravel kết nối từ máy chủ.
REVERB_PORT=8080
# Giao thức nội bộ dùng để kết nối Reverb.
REVERB_SCHEME=http
# Tên miền WebSocket công khai cho trình duyệt; để trống sẽ dùng cấu hình mặc định.
REVERB_PUBLIC_HOST=
# Cổng WebSocket công khai; để trống khi reverse proxy dùng cổng chuẩn.
REVERB_PUBLIC_PORT=
# Giao thức WebSocket công khai; `wss` bật kết nối được mã hóa TLS.
REVERB_PUBLIC_SCHEME=wss

# Chuỗi bí mật Facebook gửi khi xác minh endpoint webhook.
FACEBOOK_VERIFY_TOKEN=crm_verify_token_123
# Phiên bản Facebook Graph API dùng cho OAuth, Page và Messenger.
FACEBOOK_GRAPH_VERSION=v25.0
# App ID của ứng dụng Facebook dùng cho đăng nhập và cấp quyền Page.
FACEBOOK_CLIENT_ID=
# App Secret dùng để đổi OAuth code và xác thực request Facebook.
FACEBOOK_CLIENT_SECRET=
# URL Facebook chuyển người dùng về sau khi hoàn tất đăng nhập OAuth.
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
# ID cấu hình Facebook Login for Business nếu ứng dụng sử dụng cấu hình đăng nhập riêng.
FACEBOOK_LOGIN_CONFIG_ID=
# Các quyền Facebook cần để đọc Page, quản lý webhook và gửi nhận Messenger.
FACEBOOK_LOGIN_SCOPES=email,public_profile,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging,pages_user_gender
# Bí mật dùng để kiểm tra chữ ký webhook Facebook; có thể dùng cùng Client Secret.
FACEBOOK_APP_SECRET=
# App ID riêng của Messenger; mặc định dùng chung Facebook Client ID.
MESSENGER_APP_ID="${FACEBOOK_CLIENT_ID}"
# App Secret riêng của Messenger; mặc định dùng chung Facebook Client Secret.
MESSENGER_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"
# Access token của Zalo Official Account dùng để gọi API gửi tin.
ZALO_ACCESS_TOKEN=

# Số phút khách hàng im lặng trước khi hệ thống xếp lịch gửi tin nhắc theo dõi.
CUSTOMER_IDLE_FOLLOW_UP_MINUTES=3

# API key NVIDIA NIM dùng để sinh gợi ý trả lời bằng mô hình ngôn ngữ.
NVIDIA_NIM_API_KEY=
# Endpoint OpenAI-compatible của dịch vụ NVIDIA NIM.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Tên mô hình chat được dùng để tạo gợi ý trả lời.
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
# Thời gian tối đa, tính bằng giây, chờ phản hồi từ NVIDIA NIM.
NVIDIA_NIM_TIMEOUT=12

# Bật hoặc tắt tự động chuyển tin khách sang chatbot production.
CHATBOT_ENABLED=false
# Endpoint nội bộ của chatbot chạy cùng server; không dùng domain công khai khi có thể gọi qua loopback.
CHATBOT_BASE_URL=http://127.0.0.1:3000/api/v1
# Secret chỉ dành cho Laravel backend gửi trong header x-api-key; tuyệt đối không đưa xuống trình duyệt.
CHATBOT_API_KEY=
# Số giây tối đa để Laravel thiết lập kết nối ban đầu tới chatbot.
CHATBOT_CONNECT_TIMEOUT=5
# Số giây tối đa cho một luồng SSE sinh câu trả lời hoàn chỉnh.
CHATBOT_STREAM_TIMEOUT=120
# Thời gian giữ lock riêng từng hội thoại để không chạy hai lần sinh đồng thời.
CHATBOT_LOCK_SECONDS=150
# Queue xử lý chatbot; mặc định dùng queue default đang có để không cần đổi hạ tầng worker.
CHATBOT_QUEUE=default

# Bật hoặc tắt gửi push notification qua Firebase Cloud Messaging.
FIREBASE_FCM_ENABLED=false
# Đường dẫn tới file JSON service account Firebase nếu dùng file credentials.
FIREBASE_CREDENTIALS=
# ID dự án Firebase nhận push notification.
FIREBASE_PROJECT_ID=
# Email service account dùng để tạo OAuth token cho Firebase.
FIREBASE_CLIENT_EMAIL=
# Private key của service account Firebase; cần giữ nguyên ký tự xuống dòng đã escape.
FIREBASE_PRIVATE_KEY=
# Endpoint Google OAuth dùng để đổi JWT service account lấy access token.
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# Thời gian tối đa, tính bằng giây, chờ API Firebase phản hồi.
FIREBASE_TIMEOUT=10

# Bật hoặc tắt tính năng tìm kiếm ngữ nghĩa bằng vector embedding.
VECTOR_SEARCH_ENABLED=true
# Nhà cung cấp embedding; `local` dùng bộ sinh vector cục bộ của dự án.
VECTOR_SEARCH_PROVIDER=local
# Số chiều của vector embedding được lưu và so sánh.
VECTOR_SEARCH_DIMENSIONS=384
# Số kết quả ứng viên tối đa được lấy khi tìm kiếm vector.
VECTOR_SEARCH_TOP_K=50
# Điểm tương đồng tối thiểu để một kết quả được chấp nhận.
VECTOR_SEARCH_MIN_SCORE=0.08
# Số tin nhắn khách hàng gần nhất được dùng để tạo nội dung lập chỉ mục.
VECTOR_SEARCH_CUSTOMER_MESSAGE_LIMIT=40
