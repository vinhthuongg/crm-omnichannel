APP_NAME="CRM Omnichannel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_omnichannel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
PERMISSION_CACHE_STORE=array

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=crm
REVERB_APP_KEY=crm-key
REVERB_APP_SECRET=crm-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=wss

FACEBOOK_VERIFY_TOKEN=crm_verify_token_123
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_LOGIN_SCOPES=email,public_profile,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging
FACEBOOK_APP_SECRET=
MESSENGER_APP_ID="${FACEBOOK_CLIENT_ID}"
MESSENGER_APP_SECRET="${FACEBOOK_CLIENT_SECRET}"
ZALO_ACCESS_TOKEN=

BOTPRESS_ENABLED=false
BOTPRESS_API_KEY=
BOTPRESS_WEBHOOK_URL=
BOTPRESS_BASE_URL=https://chat.botpress.cloud
BOTPRESS_WEBHOOK_ID=
BOTPRESS_ENCRYPTION_KEY=
BOTPRESS_CALLBACK_SECRET=
BOTPRESS_PREFER_CALLBACK=true
BOTPRESS_RESPONSE_POLL_ATTEMPTS=24
BOTPRESS_RESPONSE_POLL_DELAY_MS=1000
BOTPRESS_IDLE_RESUME_MINUTES=2

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_TIMEOUT=12

GROQ_QUICK_REPLIES_ENABLED=false
GROQ_QUICK_REPLIES_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_QUICK_REPLY_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=8

VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_PROVIDER=local
VECTOR_SEARCH_DIMENSIONS=384
VECTOR_SEARCH_TOP_K=50
VECTOR_SEARCH_MIN_SCORE=0.08
VECTOR_SEARCH_CUSTOMER_MESSAGE_LIMIT=40
